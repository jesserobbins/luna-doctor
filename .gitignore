# build + packaging artifacts (egg-info is regenerated from pyproject.toml + VERSION)
*.egg-info/
build/
dist/
*.whl

# python
__pycache__/
*.py[cod]

# local environments
.venv/
venv/

# backups made by `luna-doctor fix` apply blocks and by hand
*.bak
*.bak.*

# artifacts the tool writes into the working directory
luna-doctor-*.png
luna-doctor-*.svg
luna-doctor-share-*.png

# editors / os
.DS_Store
*.swp

# ~/.gitignore_global ignores bin/ everywhere, which would drop the repo-local
# launcher `bin/luna-doctor` and break the symlink install path in the README.
# Re-include it explicitly, and keep any other bin/ contents ignored.
!bin/
!bin/luna-doctor
